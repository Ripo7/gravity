; Engine configuration file.
; Kept as plain text so it can be reviewed like code.

config_version=5

[application]

config/name="Gravity"
config/description="First-person gravity-blast destruction sandbox."
config/version="0.1.0"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputSetup="*res://scripts/core/input_setup.gd"
GameState="*res://scripts/game/game_state.gd"
Sfx="*res://scripts/core/sfx.gd"
Launch="*res://scripts/core/launch.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="disabled"
window/vsync/vsync_mode=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
common/physics_jitter_fix=0.0
jolt_physics_3d/simulation/sleep_velocity_threshold=0.08
jolt_physics_3d/simulation/sleep_time_threshold=0.4
jolt_physics_3d/simulation/velocity_steps=6
3d/default_gravity=18.0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="structures"
3d_physics/layer_3="debris"
3d_physics/layer_4="player"
3d_physics/layer_5="rubble"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.93, 0.93, 0.95, 1)
