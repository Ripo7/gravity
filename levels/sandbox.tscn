script = ExtResource("1_level")
title = "Bac à sable"
hint = "Tout se casse. Le trou noir fait tourner tout ce qui est dans son rayon et broie ce qui est juste autour. Le portail fait pleuvoir des pierres. Le bouclier sort tout seul devant toi. Monte par les rampes : les immeubles ont des étages et une passerelle. Un débris lancé suffit à te mettre K.O."

